GOOGLE_GEMINI_API_KEY=your_api_key_here
GOOGLE_GEMINI_MODEL=gemini-1.5-flash

# Email (Gmail SMTP)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
